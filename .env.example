# Content OS — variáveis de ambiente (exemplo). Copie para .env e preencha.
# NUNCA comite o .env real (está no .gitignore).

# Provedor de IA ativo: "mock" (default, sem chave) ou "anthropic" (real).
CONTENT_OS_LLM_PROVIDER=mock

# Chave da Anthropic (só necessária quando CONTENT_OS_LLM_PROVIDER=anthropic).
# No Claude Code na web, prefira cadastrar como "Credencial de API" do ambiente.
ANTHROPIC_API_KEY=

# Modelo Anthropic (opcional). Default: claude-opus-5 (máxima qualidade).
# Para reduzir custo: claude-sonnet-5 ou claude-haiku-4-5.
ANTHROPIC_MODEL=

# --- Notion (integração real, opcional) ---
# Token de uma "internal integration" criada em notion.so/my-integrations.
# Comece com "secret_" ou "ntn_". Compartilhe o database-alvo com essa integração.
NOTION_API_KEY=
# ID do database do Notion (32 chars, da URL do database).
NOTION_DATABASE_ID=
# Autoriza a ESCRITA real no Notion (guardrail). Sem isso, o sync só faz dry-run.
# Prefira passar --authorize na CLI a deixar isto ligado.
NOTION_SYNC_AUTHORIZE=

# Chave do Jev/TypeSafe (camada de decisão — uso futuro).
TYPESAFE_API_KEY=

# Diretório do store local do Content DNA (default: ./data).
CONTENT_OS_DATA_DIR=./data
